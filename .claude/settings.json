{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git log)",
      "Bash(hugo version)",
      "Bash(hugo build)",
      "Bash(python3 scripts/repository-doctor.py)"
